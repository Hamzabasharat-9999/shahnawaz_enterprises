PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/shahnawaz_enterprises
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Local development: frontend origin. Production: exact HTTPS frontend URL(s), comma-separated.
CLIENT_URL=http://localhost:5173
# Set TRUST_PROXY=1 only when deployed behind one trusted proxy (for example, Render).
TRUST_PROXY=0

# Optional: enables Gemini-powered responses while keeping catalog retrieval and a deterministic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Phase 18 — Cloudinary image uploads (server-side only; never prefix with VITE_)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=shahnawaz-enterprises

# Phase 21 — SMTP email notifications (leave blank to disable outbound email safely)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_ADMIN_TO=
